# Copie para o ambiente do servidor (ou exporte as variáveis antes de rodar `node server.js`)
PORT=8080
DATA_DIR=./data
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Atrás de Nginx/Caddy/Cloudflare: 1 (usa o IP real do cliente nos limites de tentativa)
TRUST_PROXY=0

# 0 = só aceita MACs que você cadastrou antes no admin
AUTO_REGISTER=1

# Fuso usado em "jogos de hoje"
TZ_NAME=America/Sao_Paulo

# Quanto tempo o painel guarda a lista M3U baixada antes de baixar de novo (minutos)
CATALOG_TTL_MIN=360

# Jogos automáticos (opcional): chave grátis em football-data.org
FOOTBALL_DATA_TOKEN=
# Ex.: BSA,CL (vazio = todas que a sua chave permitir)
FOOTBALL_COMPETITIONS=

# Sinopse/capa (opcional). TMDB é grátis só para uso NÃO comercial, veja o README.
TMDB_KEY=

# ---- Site (navegador) ----
# O painel já serve o site em "/" e faz o proxy de vídeo/capas. Só mexa nisto se precisar:
# Site hospedado em OUTRO endereço (ex.: Google AI Studio/Lovable): endereço(s) do site, separados por vírgula
CORS_ORIGIN=
# Segredo para assinar os links de vídeo/capa (vazio = novo a cada reinício; defina para não derrubar quem está assistindo)
WEB_SECRET=
# Identificação enviada ao provedor ao buscar o stream
STREAM_UA=VLC/3.0.20 LibVLC/3.0.20
# 1 = permite streams em IP interno/localhost (NÃO ligue em servidor público: abre brecha de SSRF)
ALLOW_PRIVATE_STREAMS=0

# ---- Ativação feita pelo próprio cliente (página /ativar e campo dentro do app) ----
# 0 = desliga (só você ativa pelo /admin)
SELF_ACTIVATE=1
# Dias de validade dados quando o cliente ativa sozinho e o aparelho ainda não tem validade (0 = sem validade!)
SELF_DAYS=0
# 0 = o cliente só ativa a primeira vez; trocar a lista depois só pelo /admin
SELF_REPLACE=1
# Tentativas de ativação por IP a cada 10 minutos
ACTIVATE_MAX=15

# Login só com usuário e senha (opcional; também dá para definir em /admin → "Servidor da lista")
DEFAULT_XTREAM_HOST=http://trevorcdn.online:80  # servidor padrão BoxTv; pode ser alterado no login/configuração
# DEFAULT_XTREAM_OUTPUT=mpegts

# Chave estavel opcional de 32 bytes base64url para cifrar URLs de listas no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CREDENTIAL_ENCRYPTION_KEY=
