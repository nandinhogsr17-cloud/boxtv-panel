<?xml version="1.0" encoding="utf-8"?>
<!-- Banner da tela inicial da Android TV (320x180). Troque por uma arte sua quando quiser. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#2A1B6B"
                android:startColor="#7C5CFF" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="72dp"
        android:drawable="@drawable/ic_play"
        android:gravity="center" />
</layer-list>
